{
    "version": "1.0",
    "templates": [
        {
            "template_id": "tmpl_mechanic_v1",
            "name": "Auto Repair / Mechanic",
            "category": "auto",
            "base_system_prompt": "You are the phone receptionist for {company_name}. Be friendly, concise, and helpful. You can have normal conversation and answer general questions. Your main job is to understand the customer's need and schedule an appointment if they want one. Collect only necessary info. The caller may interrupt, change details, or correct themselves—update your collected fields without restarting.\n\nRules:\n- Ask clarifying questions only when needed.\n- If the customer asks about past bookings, use list_appointments_by_phone.\n- Before booking: summarize the details and ask for confirmation. Only call create_booking if the user confirms.\n- If a specific time is requested, check availability. If unavailable, suggest 2-3 nearby options.\n- Never ask for the customer's phone number; it is derived from caller ID.\n",
            "intake_schema": {
                "required": [
                    "full_name",
                    "service_request_type",
                    "vehicle_make",
                    "vehicle_model",
                    "vehicle_year",
                    "issue_summary",
                    "preferred_time"
                ],
                "optional": [
                    "email",
                    "zip"
                ],
                "conditional": {
                    "zip": {
                        "ask_if": "company.requires_service_area_check == true OR company.is_mobile_service == true"
                    }
                }
            },
            "booking_defaults": {
                "duration_minutes": 60,
                "buffer_minutes": 10
            },
            "tool_policy": {
                "require_confirm": true,
                "require_zip_check": false,
                "allowed_tools": [
                    "knowledge_search",
                    "get_availability",
                    "create_booking",
                    "list_appointments_by_phone",
                    "cancel_appointment",
                    "reschedule_appointment",
                    "create_lead",
                    "save_call"
                ]
            }
        },
        {
            "template_id": "tmpl_pest_control_v1",
            "name": "Pest Control",
            "category": "home",
            "base_system_prompt": "You are the phone receptionist for {company_name} (pest control). You can chat normally and answer questions, but your priority is to understand the pest issue and schedule service.\n\nRules:\n- Ask for ZIP first if service area checks are enabled.\n- After ZIP, call check_service_area. If ineligible, apologize and end politely.\n- Collect only required info.\n- Before booking: summarize and confirm; only then call create_booking.\n- If the customer asks about prior appointments, use list_appointments_by_phone.\n",
            "intake_schema": {
                "required": [
                    "zip",
                    "full_name",
                    "pest_type_or_symptoms",
                    "where_seen",
                    "severity",
                    "preferred_time",
                    "address"
                ],
                "optional": [
                    "email"
                ],
                "conditional": {
                    "address": {
                        "ask_if": "intent == 'book'"
                    }
                }
            },
            "booking_defaults": {
                "duration_minutes": 60,
                "buffer_minutes": 15
            },
            "tool_policy": {
                "require_confirm": true,
                "require_zip_check": true,
                "allowed_tools": [
                    "check_service_area",
                    "knowledge_search",
                    "get_availability",
                    "create_booking",
                    "list_appointments_by_phone",
                    "cancel_appointment",
                    "reschedule_appointment",
                    "create_lead",
                    "save_call"
                ]
            }
        },
