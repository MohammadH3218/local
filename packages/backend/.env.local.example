# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=2592000

# AWS region (still needed for Cognito signing/validation)
AWS_REGION=us-east-1

# Keep real AWS credentials here if needed for Cognito calls.
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB (local)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=handycall_dev_

# Local filesystem storage (no S3 required)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.local/storage
S3_BUCKET_RECORDINGS=unused-local
S3_BUCKET_TRANSCRIPTS=unused-local

# Disable Parameter Store / AWS queues in local unless explicitly needed
USE_PARAMETER_STORE=false

# Keep these empty for local to run webhook delivery synchronously without SQS/KMS.
WEBHOOK_KMS_KEY_ID=
WEBHOOK_SQS_URL=

# Cognito (KEEP THESE AS YOUR REAL VALUES)
AWS_COGNITO_ADMIN_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_ADMIN_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_COGNITO_ADMIN_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_COGNITO_USERS_POOL_ID=us-east-1_YYYYYYYYY
AWS_COGNITO_USERS_CLIENT_ID=YYYYYYYYYYYYYYYYYYYYYYYY
AWS_COGNITO_USERS_CLIENT_SECRET=YYYYYYYYYYYYYYYYYYYYYYYY
AWS_COGNITO_CUSTOMER_POOL_ID=us-east-1_ZZZZZZZZZ
AWS_COGNITO_CUSTOMER_CLIENT_ID=ZZZZZZZZZZZZZZZZZZZZZZZZ
AWS_COGNITO_CUSTOMER_CLIENT_SECRET=ZZZZZZZZZZZZZZZZZZZZZZZZ

# Telephony + AI
TELEPHONY_PROVIDER=mock
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Local email mode
EMAIL_PROVIDER=console

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# Logging
LOG_LEVEL=debug

# Stripe (test)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_MAX=price_xxx

# Calendar Integration (OAuth)
BACKEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar-integration/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/calendar-integration/auth/microsoft/callback
