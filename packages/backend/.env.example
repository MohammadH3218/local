# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=2592000

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Cognito
AWS_COGNITO_ADMIN_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_ADMIN_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_COGNITO_ADMIN_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

AWS_COGNITO_USERS_POOL_ID=us-east-1_YYYYYYYYY
AWS_COGNITO_USERS_CLIENT_ID=YYYYYYYYYYYYYYYYYYYYYYYY
AWS_COGNITO_USERS_CLIENT_SECRET=YYYYYYYYYYYYYYYYYYYYYYYY

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_PREFIX=handycall_dev_

# S3
S3_BUCKET_RECORDINGS=handycall-recordings-dev
S3_BUCKET_TRANSCRIPTS=handycall-transcripts-dev

# Bedrock (for RAG/LLM)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1

# Telephony
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# Logging
LOG_LEVEL=debug

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_MAX=price_xxx

# Calendar Integration (OAuth)
BACKEND_URL=http://localhost:3000
# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar-integration/auth/google/callback
# Microsoft Calendar OAuth
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/calendar-integration/auth/microsoft/callback
